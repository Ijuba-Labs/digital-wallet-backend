# ==============================================================================
# Git Ignore Configuration (.gitignore)
#
# Best Practice:
# - Ignore build artifacts, dependency directories, logs, and sensitive environment files.
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Build Output
dist/
build/
*.tsbuildinfo

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
.env.tunnel
.env.*
!.env.example
!.env.tunnel.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

run.sh
utils.sh
LOCAL_SETUP_TEMPLATE.md
# Mounted encryption keyrings and runtime secrets
secrets/
*.tar.gz
*.tgz
