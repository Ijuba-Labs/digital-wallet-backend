# ==============================================================================
# Environment Configuration Example (.env.example)
#
# Best Practice:
# - Commit this template file to source control without sensitive values.
# - Duplicate this file to create `.env` for local development.
# - Do not commit `.env` containing production credentials or secret keys.
# ==============================================================================

# Server Settings
PORT=9000
NODE_ENV=development
# NGROK_AUTHTOKEN=your_actual_auth_token_here
# NGROK_DOMAIN=your_actual_domain_here

# Database Settings
# Local Docker defaults. For host processes, see docs/DEVELOPER_GUIDE.md.
POSTGRES_DB=wallet_backend
POSTGRES_USER=wallet_dev
POSTGRES_PASSWORD=wallet_dev_password
DATABASE_URL=postgresql://wallet_dev:wallet_dev_password@shared-database:5432/wallet_backend
DB_HOST=shared-database
DB_USER=wallet_dev
DB_PASSWORD=wallet_dev_password
DB_PORT=5432
TEST_DB_NAME=wallet_backend_test
DB_TEST_PORT=5433
MOCK_USERS_COUNT=0
SEED_USERS=5

# Redis Settings (local Docker only)
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=wallet_dev_redis_password
REDIS_URL=redis://shared-redis:6379

# Security & Authentication
# Generate a random value; see the README quick start.
JWT_SECRET=
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_EXPIRES_IN=15m

# Logging & Debugging
LOG_LEVEL=debug

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Open Payments
CLIENT_WALLET_ADDRESS_TEST_NET=https://ilp.interledger-test.dev/ijubane
KEY_ID_TEST_NET=
# Docker Compose mounts this host file read-only at /run/secrets/open_payments_private_key.
# Use the saved wallet download in development and production.
# Set an absolute path; the file itself is excluded from the Docker image.
# Example: /absolute/path/to/open-rewards-core/wallet-keys/ijubane_private.key
# The sibling open-rewards-core/scripts/saved-key.sh discovers the matching key ID.
OPEN_PAYMENTS_PRIVATE_KEY_HOST_PATH=

# Development only: 32 random bytes as 64 hex characters.
GRANT_ENCRYPTION_KEY=
# Production: mount a JSON keyring and set its path. See docs/DEVELOPER_GUIDE.md.
# ENCRYPTION_KEYRING_FILE=/run/secrets/payment_keyring
# PAYMENT_KEYRING_HOST_PATH=/secure/path/payment-keyring.json
# For non-Docker local runs only, set PRIVATE_KEY_PATH_TEST_NET to the host file path.
# HTTPS provider origins permitted for Open Payments requests, comma-separated.
# OPEN_PAYMENTS_ALLOWED_ORIGINS=https://wallet.example,https://auth.example

# Browser-reachable API origin, including the host port (not the container port).
# Use your public HTTPS API/tunnel origin when testing on a physical phone.
API_PUBLIC_URL=http://localhost:9001

# Leave empty until these clients exist. Requests default to clientId=api.
# Production web destinations and all mobile destinations require HTTPS.
ONBOARDING_WEB_RETURN_URL=
ONBOARDING_MOBILE_RETURN_URL=

# Session lifetime: integer minutes, 1 through 60.
ONBOARDING_SESSION_TTL_MINUTES=15
# Legacy SESSION_TTL_MS also means minutes; the new name takes precedence.

# Read-only private checkout identity lookup. Separate from JWT and database credentials.
CHECKOUT_IDENTITY_SERVICE_KEY=
