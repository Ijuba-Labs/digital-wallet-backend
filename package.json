{
  "_comment": "Backend package configuration. Define scripts, dependencies, and project metadata here.",
  "name": "backend",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.4",
  "description": "Backend API service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
     "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "tunnel:start": "tsx local-tunnel-setup.ts",
    "localenv:compose": "docker compose -f docker/base/docker-compose.yml --env-file ./.env -f docker/dev/docker-compose.yml --env-file ./.env",
    "localenv:dev": "pnpm localenv:compose up --build --watch wallet-api",
    "localenv:clean": "pnpm localenv:compose down --volumes --rmi all",
    "api:logs": "pnpm localenv:compose logs -f wallet-api",
    "knex": "tsx ./node_modules/knex/bin/cli.js",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.0",
    "@interledger/open-payments": "^7.4.0",
    "@ngrok/ngrok": "^1.7.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "helmet": "^8.3.0",
    "install": "^0.13.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "nock": "^14.0.17",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.0",
    "@types/pino-http": "^6.1.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2"
  }
}
